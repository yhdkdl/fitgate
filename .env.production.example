# ==============================================================================
# FitGate Production Environment Configuration Template (.env.production.example)
#
# INSTRUCTIONS FOR HOST DEPLOYMENT:
# 1. Place this file OUTSIDE public_html and outside the application release folder,
#    for example at: /home/<cpanel_user>/fitgate_env/.env
# 2. Restrict file permissions immediately to prevent unauthorized access:
#    chmod 600 /home/<cpanel_user>/fitgate_env/.env
# 3. Fill in every value below. Never leave secrets empty.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
# Fully qualified platform domain (apex host name for Super Admin & marketing)
DOMAIN=fitgate.tebebtech.com

# Cryptographic signing secret key (generate with: python manage.py generate_secret_key)
SECRET_KEY=

# Production mode strictly requires DEBUG=False
DEBUG=False

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (cPanel PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgres://<cpanel_user>_<db_user>:<password>@localhost:5432/<cpanel_user>_<db_name>
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. CPANEL UAPI SUBDOMAIN PROVISIONING
# ------------------------------------------------------------------------------
# Mock flag: strictly False in production to enable real automated subdomain creation
CPANEL_USE_MOCK=False

# Hostname or IP of the cPanel server (e.g. localhost, server hostname, or domain)
CPANEL_HOST=

# cPanel cPanel account username
CPANEL_USERNAME=

# cPanel API Token with permission for SubDomain module (create in cPanel: Manage API Tokens)
CPANEL_API_TOKEN=

# Document root path shared by platform and gym subdomains (e.g. public_html/fitgate)
CPANEL_SUBDOMAIN_DOCROOT=public_html/fitgate

# ------------------------------------------------------------------------------
# 4. ENCRYPTION & ASYMMETRIC SIGNING KEYS
# ------------------------------------------------------------------------------
# 32-byte key used to encrypt gym payment credentials in database
# (generate with: python manage.py generate_tenant_credentials_key)
TENANT_CREDENTIALS_KEY=

# Asymmetric Ed25519 private key in PEM format (single-line escaped with \n)
# (generate with: python manage.py generate_qr_dev_keys)
QR_JWT_PRIVATE_KEY=

# Asymmetric Ed25519 public key in PEM format (single-line escaped with \n)
# (generate with: python manage.py generate_qr_dev_keys)
QR_JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 5. OUTBOUND EMAIL SETTINGS (SMTP - Brevo / Resend)
# ------------------------------------------------------------------------------
# Django email backend (standard SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server hostname (Brevo: smtp-relay.brevo.com | Resend: smtp.resend.com)
EMAIL_HOST=smtp-relay.brevo.com

# SMTP port number (587 for Brevo STARTTLS | 465 for Resend SSL)
EMAIL_PORT=587

# SMTP account login username
EMAIL_HOST_USER=

# SMTP account password or API secret key
EMAIL_HOST_PASSWORD=

# Enable STARTTLS encryption (True for port 587; must NOT be True if EMAIL_USE_SSL is True)
EMAIL_USE_TLS=True

# Enable implicit SSL encryption (True for port 465; must NOT be True if EMAIL_USE_TLS is True)
EMAIL_USE_SSL=False

# Verified default sender address matching authenticated domain (e.g. noreply@fitgate.tebebtech.com)
DEFAULT_FROM_EMAIL=noreply@fitgate.tebebtech.com

# ------------------------------------------------------------------------------
# 6. PERSISTENT STORAGE & LOGGING DIRECTORIES
# ------------------------------------------------------------------------------
# Persistent media directory OUTSIDE public_html and release folder (survives new releases)
# Example: /home/<cpanel_user>/fitgate_media
MEDIA_ROOT=

# Dedicated directory for application logs OUTSIDE public_html and release folder
# Example: /home/<cpanel_user>/fitgate_logs
LOG_DIR=
