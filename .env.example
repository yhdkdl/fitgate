# ==============================================================================
# FitGate Local Environment Configuration Template (.env.example)
#
# QUICK START:
# 1. Copy this template to create your local .env file:
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
# 2. Generate required encryption key:
#      docker compose exec backend python manage.py generate_tenant_credentials_key
#    and paste the key into TENANT_CREDENTIALS_KEY below.
# 3. Start the containers:
#      docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & NETWORKING
# ------------------------------------------------------------------------------
# Active settings module: fitgate.settings.local for Docker dev
DJANGO_SETTINGS_MODULE=fitgate.settings.local

# Django cryptographic signing secret key. Safe default provided for local development.
# Generate a new key with: docker compose exec backend python manage.py generate_secret_key
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-fitgate-sprint0-change-in-production

# Enable debug mode and interactive traceback pages (True in local dev; strictly False in production)
DEBUG=True

# Base domain name for platform apex (localhost in development)
DOMAIN=localhost

# Host port for public frontend traffic (Vite dev server)
PUBLIC_PORT=5173

# Optional comma-separated list of extra host names allowed to connect (additive to DOMAIN and .DOMAIN)
# ALLOWED_HOSTS=

# Cross-Origin Resource Sharing (CORS) allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted origins for Cross-Site Request Forgery (CSRF) protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & INITIAL SUPER ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# HMAC signing secret for JWT tokens (leave empty to default to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# Initial Super Admin credentials for bootstrap command:
# Run: docker compose exec backend python manage.py create_super_admin
# (Remove SUPERADMIN_PASSWORD after initial setup)
SUPERADMIN_EMAIL=admin@fitgate.localhost
SUPERADMIN_PASSWORD=AdminLocalPassword123!

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE & REDIS CACHE
# ------------------------------------------------------------------------------
# PostgreSQL database credentials for Docker container fitgate_postgres
POSTGRES_DB=fitgate_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Database connection URL read by Django (connects to container fitgate_postgres)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitgate_dev

# Redis connection URL for caching and token blocklist (container fitgate_redis)
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. PGADMIN (LOCAL DATABASE GUI UTILITY)
# ------------------------------------------------------------------------------
# Login credentials for pgAdmin 4 web dashboard at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@fitgate.localhost
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Backend API base URL consumed by Vite frontend dev server
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. ENCRYPTION & ASYMMETRIC SIGNING KEYS
# ------------------------------------------------------------------------------
# 32-byte Fernet key used to encrypt tenant-specific payment credentials in the database.
# REQUIRED: Generate using: docker compose exec backend python manage.py generate_tenant_credentials_key
TENANT_CREDENTIALS_KEY=

# Ed25519 asymmetric keypair for dynamic QR code attendance tokens.
# Optional in local dev: a built-in development fallback keypair is used if left blank.
# Generate new keys using: docker compose exec backend python manage.py generate_qr_keys
QR_JWT_PRIVATE_KEY=
QR_JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 7. OUTBOUND EMAIL & BREVO SETTINGS
# ------------------------------------------------------------------------------
# Email backend: console backend prints all emails to container logs (docker compose logs -f backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@fitgate.localhost

# Optional SMTP configuration (only needed if testing real email delivery through Brevo)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# Email safety restrictions (Sprint 9b): strictly limit recipients in staging/production
EMAIL_STRICT_MODE=False
BREVO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY INTEGRATIONS & LOCAL MOCK FLAGS
# ------------------------------------------------------------------------------
# cPanel UAPI Subdomain Provisioning:
# CPANEL_USE_MOCK=True simulates subdomain creation and TLS certificate checks without calling cPanel.
CPANEL_USE_MOCK=True
CPANEL_HOST=
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_ROOT_DOMAIN=localhost
CPANEL_SUBDOMAIN_DOCROOT=public_html/fitgate

# AI Plan Generation (Sprint 22):
# Optional external AI providers. If left empty, the built-in mock engine generates realistic plans.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Telegram Notice Board Bridge (Sprint 28):
# If TELEGRAM_USE_MOCK=True or token is empty, mock broadcaster logs messages without network calls.
TELEGRAM_USE_MOCK=True
TELEGRAM_BOT_TOKEN=

# Bank Receipt Verification (Sprint 12d):
# In local dev, BANK_RECEIPT_VERIFIER_USE_MOCK=True simulates receipt verification.
RECEIPT_VERIFICATION_ENABLED=False
BANK_RECEIPT_VERIFIER_USE_MOCK=True

# Local development tunnel host for testing inbound webhooks (e.g. abc123def.ngrok-free.app)
# Hostname only (no https://). Restricts traffic exclusively to /api/webhooks/chapa/
DEV_TUNNEL_HOST=

# ------------------------------------------------------------------------------
# 9. DEMO GYM SEEDING & TEST OVERRIDES
# ------------------------------------------------------------------------------
# Guard flag to allow seeding the 'demo' subdomain gym. NEVER enable in production.
ALLOW_DEMO_SEED=False

# Password assigned to pre-seeded demo accounts (owner@demo.local, member1@demo.local, etc.)
DEMO_PASSWORD=

# Optional PostgreSQL 13 validation override flag (local.py)
ALLOW_POSTGRES_13=False
