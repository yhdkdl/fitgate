# ==========================================
# FitGate Environment Configuration Template
# ==========================================
# Copy this file to .env before starting the stack:
# cp .env.example .env

# --- Django Core ---
DJANGO_SETTINGS_MODULE=fitgate.settings.local
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-fitgate-sprint0-change-in-production
DEBUG=True
DOMAIN=localhost
PUBLIC_PORT=5173
# ALLOWED_HOSTS is optional; extra hosts configured here are additive to DOMAIN and .{DOMAIN}
# ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Authentication & JWT (Sprint 2) ---
JWT_SIGNING_KEY=
# Super Admin initial bootstrap (Sprint 2) — remove SUPERADMIN_PASSWORD after first run
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Email Configuration ---
# Console backend in local dev; SMTP in production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- PostgreSQL Database ---
POSTGRES_DB=fitgate_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitgate_dev

# --- Redis Cache ---
REDIS_URL=redis://redis:6379/1

# --- pgAdmin (Local Dev Convenience Only) ---
PGADMIN_DEFAULT_EMAIL=admin@fitgate.tebebtech.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Third-Party Integrations (Future Sprints / Production) ---
# Chapa Payment Gateway (Sprint 11)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=

# LiteLLM / External AI Engine (Sprint 22)
LITELLM_API_KEY=
OPENROUTER_API_KEY=

# cPanel UAPI Subdomain Provisioning (Sprint 4 / Sprint 38)
CPANEL_API_TOKEN=
CPANEL_HOST=
CPANEL_USERNAME=

# --- QR Check-in Asymmetric Token Configuration (Sprint 8) ---
# Generate using: python manage.py generate_qr_keys
QR_JWT_PRIVATE_KEY=
QR_JWT_PUBLIC_KEY=
